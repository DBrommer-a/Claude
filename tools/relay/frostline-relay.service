# systemd-Dienst für den Frostline Relay.
# Einrichten (als root):
#   install -D -m 644 frostline_relay.py /opt/frostline-relay/frostline_relay.py
#   install -m 644 frostline-relay.service /etc/systemd/system/frostline-relay.service
#   systemctl daemon-reload && systemctl enable --now frostline-relay
#   ufw allow 47821/udp   (falls ufw aktiv ist)
[Unit]
Description=Frostline Relay (iPhone-Fernsteuerung über das Internet)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/frostline-relay/frostline_relay.py --port 47821
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
